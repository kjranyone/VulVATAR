/target/
# Alternate CARGO_TARGET_DIR for diagnostic binaries built while the app is
# running (the live app locks realsense2.dll in the main target) — see
# CLAUDE.md "Live debugging".
/target-test/
/Cargo.lock

# Local asset staging
/assets/
!/assets/.gitkeep
!/assets/NotoSansJP-Regular.otf

# Editor and OS noise
/.vscode/
/.idea/
*.swp
*.tmp
Thumbs.db
.DS_Store

# ONNX models fetched by `dev.ps1` (not committed).
models/*.onnx

# Retired PoC dumps — ignore if they reappear on disk.
models/hmr2*
models/backbone.*
models/onnx__*
models/smpl_head.*
models/vitpose-h-wholebody_onnx/
/hmr2_export/

# Gemini / Antigravity CLI workspace symlink
/.antigravitycli/

# ZCode CLI session workspace
/.zcode/

# Sample data (keep directory)
/sample_data/*
!/sample_data/.gitkeep

# Diagnostic output
/diagnostics/

# Scratch / ad-hoc tooling workspace (live debug scripts, throwaway probes)
/scratchpad/

# Local venvs provisioned by dev.ps1 (face landmark sidecar runtime env)
/tools/

# Python bytecode (depth_capture.py and other scripts run via uv)
__pycache__/
*.pyc

# Profiling logs (see docs/profiling.md)
/profile/

# Runtime logs captured when launching the app from a script / CI
*.stdout.log
*.stderr.log

# Image-sequence output dir created by the frame sink at runtime
/output_frames/

# Inno Setup installer build output
/installer/output/

# Misc
nul
/logs/

# Machine-local pkg-config shim for the RealSense SDK. Regenerated per
# machine from `realsense2.pc.example` (see docs/realsense-build.md) —
# the SDK install path differs on every developer box.
/build-support/pkgconfig/realsense2.pc

# Local ML training/bench artifacts (hand-model campaign leftovers).
/datasets/
/runs/
/weights/
# model binaries beyond the *.onnx pattern: external-weight companions,
# tflite exports, canonical npy meshes and local backup copies
models/*.onnx.data
models/*.tflite
models/*.npy
models/*.bak
models/*.json
models/*bak

# ...except the face sidecar's correspondence data, which is tracked
# (it was force-added past these patterns). Both files are generated
# offline by scratchpad/build_face98_mapping.py from the WFLW test
# split, but together they are under 50 KB, nothing hosts them, and
# `face_rtmtface` refuses to start without them — so a fresh clone must
# carry them. Spelling that out here keeps the next `git add models/`
# from silently dropping them again.
!models/mp_canonical478.npy
!models/mp_wflw98_idx.json

# legacy repo-local python venv layout (nothing creates it anymore;
# resolve_sidecar_python still honours it if present)
.venv/
